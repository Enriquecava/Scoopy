# For PostgreSQL on the Docker host on Linux, use host.docker.internal and
# allow connections from Docker bridge networks in PostgreSQL and the firewall.
# If PostgreSQL runs in another container, use its service name on a shared
# Docker network instead. "localhost" refers to each application container.
PGHOST=
PGPORT= 
PGUSER= 
PGPASSWORD= 
PGDATABASE= 
PLAYWRIGHTHEADLESS=
SCRAPER_BATCH_DELAY_MS=

# --- Docker (docker-compose.yml / scoopy-api / frontend) ---
# Name of the external Docker network created by the compose project that runs
# the Cloudflare tunnel (cloudflared). Must match that network's name exactly.
TUNNEL_NETWORK_NAME=tunnel_net
# From `bin/rails credentials:edit` / scoopy-api/config/master.key.
RAILS_MASTER_KEY=
# Generate with `openssl rand -hex 64`; keep the value private in .env.
SECRET_KEY_BASE=
# Host-side port only (container always listens on 3000 for Puma/the tunnel).
API_PORT=3000
# How often (seconds) the scraper container re-runs the batch processor.
SCRAPER_BATCH_INTERVAL_SECONDS=14400
# Public URL (through the tunnel) the frontend uses to call the API. Baked
# into the frontend bundle at build time, so rebuild the image after changing it.
VITE_API_URL=http://localhost:3000
FRONTEND_PORT=8080
# Comma-separated list of origins the API accepts requests from (must include
# the public frontend URL exposed through the tunnel).
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Internal URL the API uses to call the scraper's verifier HTTP service
# (defaults to the Docker service name "verifier" on the shared backend network).
SCRAPER_VERIFIER_URL=http://verifier:4000/verify
# Server-side deadline (ms) for a single verification; must stay below the
# Rails-side PROCESS_TIMEOUT_SECONDS (30s) so the browser is force-closed first.
VERIFIER_TIMEOUT_MS=25000